def clear_screen():
   os.system('cls'if os.name == 'nt' else 'clear')
 
class Member:
   def __init__(self,first_name ,last_name,ID,status='inactive'):
      self.first_name=first_name
      self.last_name=last_name
      self.ID=ID
      self.status=status
   def display_member(self):
      print(f"the member name is {self.first_name} {self.last_name}\n and his ID is {self.ID}\n and his status is {self.status}\n {'-'*20}")

def create_member():
   clear_screen()
   first_name=input("Enter the first name:")
   last_name=input("Enter the last name:")
   ID=input("Enter membership ID :")
   status=input("Enter membership status,Or click enter  ")
   if  not status:
      status="inactive"   
   return Member(first_name ,last_name,ID,status)

